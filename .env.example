# ---- LLM configuration (OpenAI-compatible) ----
# The app talks to any OpenAI-compatible endpoint, so you can use OpenAI,
# a local model via Ollama, Groq, etc. Pick ONE of the options below.

# --- Option A: OpenAI (needs an API key, paid) ---
LLM_API_KEY=sk-your-openai-key-here
LLM_MODEL=gpt-4o-mini
# Optional: grade eval answers with a different (ideally stronger) model than the one answering.
# JUDGE_MODEL=
# LLM_BASE_URL is left empty -> uses the default OpenAI endpoint

# --- Option B: Free & local via Ollama (no API key, no cost) ---
# 1. Install Ollama: https://ollama.com
# 2. Pull a model:   ollama pull llama3.2
# 3. Uncomment the three lines below and comment out Option A:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2

# ---- Embeddings (runs locally, free, downloads ~80MB on first run) ----
EMBED_MODEL=all-MiniLM-L6-v2

# ---- Retrieval / chunking ----
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4

# ---- Chunking: "char" (fixed windows, default) or "heading" (split by headings/paragraphs) ----
CHUNKING=char

# ---- Retrieval mode: "hybrid" (default: BM25 keyword + vectors) or "vector" ----
RETRIEVAL_MODE=hybrid
